# Copy to .env for local runs. On Liara, set these as environment variables.
ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./the_case.db
JWT_SECRET=change-me-dev-only
ADMIN_API_KEY=change-me-admin-dev-only
AUTO_CREATE_TABLES=true
BAZAAR_MODE=fake
BAZAAR_PACKAGE_NAME=ir.aminsalem.the_case
BAZAAR_API_SECRET=
